# Runtime environment
# install.bat / npm run setup:local creates .env with a random secret automatically.
# If creating .env manually, replace this sample with a unique 32+ character value.
KOSU_SESSION_SECRET=change-me-to-a-random-32-character-secret

# Optional: SQLite data directory. Defaults to ./data when omitted.
KOSU_DATA_DIR=./data

# Optional: SQLite busy timeout in milliseconds. Defaults to 5000 when omitted.
KOSU_SQLITE_BUSY_TIMEOUT_MS=5000

# Set to production for deployed environments.
NODE_ENV=development

# Direct local startup: process environment overrides values in .env.
# start:local always uses NODE_ENV=production and binds to 127.0.0.1.
HOST=127.0.0.1
PORT=3000
